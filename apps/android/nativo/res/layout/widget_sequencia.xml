<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_fundo">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Logic Academy" android:textColor="#9CA3AF" android:textSize="12sp" />
    <TextView android:id="@+id/w_seq" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🔥 0 dias" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_prox" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Abra o app" android:textColor="#E5E7EB" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#22D3EE" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
