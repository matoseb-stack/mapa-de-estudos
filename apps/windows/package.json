{
  "name": "logic-academy",
  "productName": "Logic Academy",
  "version": "1.0.0",
  "description": "Logic Academy para Windows",
  "author": "Logic Academy",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.logicacademy.estudos",
    "productName": "Logic Academy",
    "files": ["main.js", "preload.js", "offline.html", "icone.png"],
    "win": { "icon": "icone.png", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": true, "artifactName": "LogicAcademy-Instalador.exe", "createDesktopShortcut": true, "shortcutName": "Logic Academy" },
    "portable": { "artifactName": "LogicAcademy-Portatil.exe" }
  }
}
